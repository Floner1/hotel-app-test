# Environment variables read by site1/site1/settings.py.
#
# Copy this file to site1/.env (NOT the repo root — settings.py calls
# load_dotenv(BASE_DIR / '.env') and BASE_DIR is the site1/ directory).
# Values shown are the defaults settings.py falls back to when the variable is
# absent. Do not quote values containing backslashes; python-dotenv treats
# backslash escapes inside double-quoted values.

# ---------- Core ----------
# Required. Startup raises ImproperlyConfigured if this is missing.
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 'true' enables DEBUG. Anything else is False, which switches on
# SECURE_SSL_REDIRECT and HSTS — leave this true for local dev or the dev
# server will force HTTPS and refuse plain http:// requests.
DJANGO_DEBUG=False

# Comma-separated. Use localhost for dev; 127.0.0.1 also works but HSTS
# previously cached on it can force HTTPS in the browser.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Database (SQL Server, Windows Authentication) ----------
# Trusted_Connection is hardcoded to 'yes' in settings.py, so there is no
# username/password variable. Auth is the Windows account running the process.
DB_NAME=hotelbooking
DB_HOST=DESKTOP-NS6H7CH\MSSQLSERVER01

# ---------- Hotel contact fallbacks ----------
# Used when the corresponding DB columns are absent.
HOTEL_DEFAULT_PHONE=+63 900 000 0000
HOTEL_DEFAULT_EMAIL=info@hotelbooking.local

# ---------- Email ----------
# Setting GMAIL_APP_PASSWORD is what flips EMAIL_BACKEND from console to real
# SMTP. Leave it empty in dev and mail prints to the console instead of sending.
GMAIL_APP_PASSWORD=
GMAIL_FROM_EMAIL=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Defaults to "Thien Tai Hotel <GMAIL_FROM_EMAIL>", or webmaster@localhost when
# GMAIL_FROM_EMAIL is empty.
DEFAULT_FROM_EMAIL=

# Defaults to GMAIL_FROM_EMAIL.
ADMIN_NOTIFICATION_EMAIL=

# Days to keep rows in the email queue before the retry/cleanup pass drops them.
EMAIL_QUEUE_RETENTION_DAYS=90

# ---------- URLs ----------
# Absolute base used to build links inside emails (unsubscribe, password reset,
# email verification). Must be the real public origin in production.
SITE_BASE_URL=http://localhost:8000

# Comma-separated full origins, required once served over HTTPS from a real
# domain, e.g. https://book.example.com,https://www.example.com
# Not needed for same-origin localhost dev.
CSRF_TRUSTED_ORIGINS=
